    given-names: Ahmed
    website: https://ahmedjaffar.ca
date-released: "2026-11-07"
license: MIT
repository-code: "https://github.com/AhmedJaffar/ai-prose-clock"
keywords:
  - computational social science
  - LLM-assisted writing
  - stylometry
  - excess vocabulary
  - diffusion
type: software
